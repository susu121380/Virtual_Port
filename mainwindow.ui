     <widget class="QGroupBox" name="groupBox_3">
      <property name="title">
       <string>数据格式说明</string>
      </property>
      <layout class="QVBoxLayout" name="verticalLayout_2">
       <item>
        <widget class="QLabel" name="label_3">
         <property name="text">
          <string>数据包格式: A3 B4 55 [D1_L D1_H] [D2_L D2_H] ... [D8_L D8_H] FF FF
• 帧头: A3 B4
• 标识: 55
• 数据: 8个int16_t随机值 (每个2字节, 小端序)
• 帧尾: FF FF
• 总长度: 21字节</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
