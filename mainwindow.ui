    <item>
     <widget class="QGroupBox" name="groupBox_6">
      <property name="styleSheet">
       <string notr="true">QGroupBox {
            border: 2px solid #D6EAF8;
            border-radius: 12px;
            margin-top: 15px;
            padding: 12px;
            color: rgb(255, 255, 255);
			background-color: rgb(80, 80, 80);
        }
        QGroupBox::title {
            subcontrol-origin: margin;
            subcontrol-position: top left;
            left: 12px;
            top: -0px;
            padding: 0 8px;
            color: rgb(255, 255, 255);
            font-weight: bold;
            font-size: 11pt;
        }
        QComboBox {
            background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                        stop:0 #FFFFFF, stop:1 #F5F7FA);
            border: 2px solid #E8EDF2;
            border-radius: 12px;
            padding: 8px 12px;
            color: #2C3E50;
            font-family: '微软雅黑';
            font-size: 10pt;
            min-height: 20px;
        }
        QComboBox:hover {
            border: 2px solid #5DADE2;
        }
        QComboBox::drop-down {
            subcontrol-origin: padding;
            subcontrol-position: top right;
            width: 35px;
            border-left: 1px solid #E8EDF2;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
        }
        QComboBox::down-arrow {
            image: url(:/Pix/png/Down.png);
            width: 12px;
            height: 12px;
        }
        QComboBox QAbstractItemView {
            border: 2px solid #E8EDF2;
            background-color: #FFFFFF;
            border-radius: 10px;
            padding: 4px;
        }
        QComboBox QAbstractItemView::item {
            border-radius: 6px;
            min-height: 32px;
            padding: 4px 8px;
        }
        QComboBox QAbstractItemView::item:hover {
            background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                        stop:0 #EBF5FB, stop:1 #D6EAF8);
        }
        QPushButton
        {
           font-family: '微软雅黑';
           color: white;
           border: none;
           background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                       stop:0 #5DADE2, stop:1 #3498DB);
           border-radius: 8px;
           font-size: 8pt;
           font-weight: bold;
           padding: 8px 16px;
           min-height: 28px;
        }
        QPushButton:hover
        {
           background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                       stop:0 #85C1E9, stop:1 #5DADE2);
        }
        QPushButton:pressed
        {
           background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                       stop:0 #2E86C1, stop:1 #21618C);
           padding-top: 10px;
        }
        QCheckBox::indicator:checked {
            background-color: transparent;
            border: 2px solid #3498DB;
            image: url(:/Pix/png/correct.png);
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }
        QCheckBox::indicator:unchecked {
            background-color: #FFFFFF;
            border: 2px solid #BDC3C7;
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }
        QLineEdit {
            background-color: #FFFFFF;
            border: 2px solid #E8EDF2;
            border-radius: 8px;
            padding: 6px 12px;
            color: #2C3E50;
            font-family: '微软雅黑';
            font-size: 10pt;
        }
        QLineEdit:hover {
            border: 2px solid #5DADE2;
        }
        QLineEdit:focus {
            border: 2px solid #3498DB;
        }
QDoubleSpinBox { 
    background: #1f2326; 
    color: #e6eef6;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 6px;
    padding: 4px 10px 4px 10px; 
    min-height: 28px; 
    selection-background-color: rgba(255,255,255,0.12); 
    selection-color: #ffffff; 
    font: 15px &quot;Segoe UI&quot;;
} 

QDoubleSpinBox::up-button {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    height: 18px;
    border: none;
    background: transparent;
}

QDoubleSpinBox::down-button {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    width: 18px;
    height: 18px;
    border: none;
    background: transparent;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(255,255,255,0.02);
} 

QDoubleSpinBox::up-arrow {
    width: 16px;
    height: 16px;
	margin-top: -12px;
	image: url(:/Pix/png/Up.png);
}

QDoubleSpinBox::down-arrow {
    width: 16px;
    height: 16px;
	margin-top: 12px;
	image: url(:/Pix/png/downbtn.png);
}

QDoubleSpinBox:focus { 
    border: 1px solid qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6dd3f5, stop:1 #7fffb5); 
} 

QDoubleSpinBox:disabled { 
    color: rgba(230,238,246,0.4);
    background: rgba(255,255,255,0.02);
    border-color: rgba(255,255,255,0.02); 
}
  
QTextEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #969696, stop:1 #282828);
    color: #E6EEF3;
    border: 1px solid rgba(255,255,255,0.8);
    border-radius: 10px;
    padding: 10px;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, Arial;
    font-size: 12px;
    selection-background-color: #2F7BC9;
    selection-color: #FFFFFF;
}
QTextEdit[readOnly=&quot;true&quot;] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #252A30, stop:1 #1C2024);
    color: #AAB6C2;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 8px 2px 8px 2px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.10);
    min-height: 20px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.16);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 2px 8px 2px 8px;
}
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.10);
    min-width: 20px;
    border-radius: 4px;
}</string>
